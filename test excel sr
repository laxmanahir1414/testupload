  // ============================================================
  // GET NUMERIC VALUE
  //
  // IMPORTANT:
  //
  // Handles normal values AND ExcelJS formula objects.
  //
  // Formula Cell:
  //
  // {
  //    formula: 'A3*B3',
  //    result: 500
  // }
  //
  // ============================================================

  getNumericValue(
    cell: ExcelJS.Cell
  ): number {

    const value =
      cell.value;


    // ============================================================
    // NULL
    // ============================================================

    if (

      value === null ||

      value === undefined

    ) {

      return 0;
    }


    // ============================================================
    // FORMULA RESULT
    // ============================================================

    if (

      typeof value === 'object' &&

      value !== null &&

      'result' in value

    ) {

      const formulaValue =
        value as ExcelJS.CellFormulaValue;


      const result =
        Number(
          formulaValue.result
        );


      return Number.isNaN(result)

        ? 0

        : result;
    }


    // ============================================================
    // NORMAL VALUE
    // ============================================================

    const numericValue =
      Number(value);


    return Number.isNaN(numericValue)

      ? 0

      : numericValue;
  }


  // ============================================================
  // GET CELL DISPLAY VALUE
  // ============================================================

  private getCellDisplayValue(
    cell: ExcelJS.Cell
  ): string {

    const value =
      cell.value;


    if (

      value === null ||

      value === undefined

    ) {

      return '';
    }


    // Formula
    if (

      typeof value === 'object' &&

      value !== null &&

      'result' in value

    ) {

      const formulaValue =
        value as ExcelJS.CellFormulaValue;


      return String(
        formulaValue.result ?? ''
      );
    }


    // Rich Text
    if (

      typeof value === 'object' &&

      value !== null &&

      'richText' in value

    ) {

      const richText =
        value as ExcelJS.CellRichTextValue;


      return richText.richText

        .map(
          item => item.text
        )

        .join('');
    }


    return String(value);
  }


