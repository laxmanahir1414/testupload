import {
  Component,
  EventEmitter,
  Input,
  Output
} from '@angular/core';

import { ExcelRow } from 'src/app/models/excel-row.model';

import { ExcelValidatorService }
  from 'src/app/services/shared/excel-validator.service';

import { apiService }
  from 'src/app/services/api/api.service';

import * as ExcelJS from 'exceljs';

import { saveAs } from 'file-saver';

import {
  BulkUploadRow,
  UploadResponse
} from 'src/app/models/budget-data-model';


@Component({
  selector: 'app-budget-entry-upload',

  templateUrl:
    './budget-entry-upload.component.html',

  styleUrls:
    ['./budget-entry-upload.component.scss'],

  standalone: false
})

export class BudgetEntryUploadComponent {


  // ============================================================
  // INPUT / OUTPUT
  // ============================================================

  @Input()
  parentData: any;


  @Output()
  closed = new EventEmitter<boolean>();


  // ============================================================
  // VARIABLES
  // ============================================================

  selectedType: number = 1;

  selectedFile: File | null = null;


  templateError: string | null = null;


  rows: ExcelRow[] = [];

  columns: string[] = [];


  isValidating = false;

  isSubmitting = false;

  submitMessage: string | null = null;

  submitSuccess = false;


  extracting = false;


  serverMessage: string | null = null;

  serverSuccess = false;


  // ============================================================
  // CONSTRUCTOR
  // ============================================================

  constructor(

    private excelValidator: ExcelValidatorService,

    private uploadService: apiService

  ) {}


  // ============================================================
  // CLIENT ERROR CHECK
  // ============================================================

  get hasClientErrors(): boolean {

    return this.rows.some(
      row => row.hasError
    );
  }


  // ============================================================
  // ERROR ROW COUNT
  // ============================================================

  get errorRowCount(): number {

    return this.rows.filter(
      row => row.hasError
    ).length;
  }


  // ============================================================
  // FILE SELECT
  // ============================================================

  onFileSelected(
    event: Event
  ): void {

    const input =
      event.target as HTMLInputElement;


    this.selectedFile =
      input.files?.[0] ?? null;


    this.resetGrid();
  }


  // ============================================================
  // VALIDATE EXCEL
  // ============================================================

  async validateExcel(): Promise<void> {

    if (!this.selectedFile) {
      return;
    }


    this.isValidating = true;


    this.resetGrid();


    try {

      const result =
        await this.excelValidator.parseAndValidate(
          this.selectedFile
        );


      // ============================================================
      // TEMPLATE INVALID
      // ============================================================

      if (!result.templateValid) {

        this.templateError =
          result.templateError;

        return;
      }


      // ============================================================
      // ASSIGN GRID DATA
      // ============================================================

      this.rows =
        result.rows;


      this.columns =
        result.columns;


    } catch (error) {

      this.templateError =
        'Could not read the file. Please make sure it is a valid .xlsx/.xls file.';


      console.error(error);


    } finally {

      this.isValidating = false;
    }
  }


  // ============================================================
  // SUBMIT
  // ============================================================

  submit(): void {

    if (

      this.hasClientErrors ||

      !this.rows.length ||

      this.isSubmitting

    ) {

      return;
    }


    this.isSubmitting = true;


    this.submitMessage = null;


    this.submitSuccess = false;


    const payload = {

      entrytype:
        this.selectedType,


      rows:
        this.rows.map(
          row => row.data
        ),


      yearcode:
        this.parentData.fycode,


      quartercode:
        this.parentData.quartercode,


      rolename:
        this.parentData.rolename
    };


    this.uploadService
      .uploadData(payload as any)
      .subscribe({


        // ============================================================
        // SUCCESS
        // ============================================================

        next: (
          response: UploadResponse
        ) => {

          this.isSubmitting = false;


          // ============================================================
          // SERVER VALIDATION ERRORS
          // ============================================================

          if (

            response.rows?.some(
              row => row.errors?.length
            )

          ) {

            const errorMap =
              new Map(

                response.rows.map(
                  row => [

                    row.rowNumber,

                    row.errors
                  ]
                )

              );


            this.rows.forEach(
              row => {

                if (

                  errorMap.has(
                    row.rowNumber
                  )

                ) {

                  row.errors =
                    errorMap.get(
                      row.rowNumber
                    )!;


                  row.hasError = true;

                } else {

                  row.errors = [];

                  row.hasError = false;
                }
              }
            );


            const successCount =
              response.rows.filter(
                row => !row.errors?.length
              ).length;


            const failedCount =
              response.rows.filter(
                row => row.errors?.length
              ).length;


            this.submitSuccess = false;


            this.submitMessage =

              response.resultMessage +

              '<br/> ' +

              `${successCount} row(s) saved successfully. ` +

              `${failedCount} row(s) failed validation in the database — ` +

              `fix the highlighted rows in Excel and reupload.`;


          } else {


            // ============================================================
            // ALL SUCCESS
            // ============================================================

            this.submitSuccess = true;


            this.submitMessage =
              `All ${response.rows.length} row(s) saved successfully.`;
          }
        },


        // ============================================================
        // ERROR
        // ============================================================

        error: (
          error
        ) => {

          this.isSubmitting = false;


          this.submitSuccess = false;


          this.submitMessage =
            'Upload failed: could not reach the API.';


          console.error(error);
        }
      });
  }


  // ============================================================
  // RESET GRID
  // ============================================================

  private resetGrid(): void {

    this.templateError = null;


    this.rows = [];


    this.columns = [];


    this.submitMessage = null;


    this.submitSuccess = false;
  }


  // ============================================================
  // CLOSE
  // ============================================================

  close(): void {

    this.closed.emit(
      this.submitSuccess
    );
  }


