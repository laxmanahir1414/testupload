  getNumericValue(cell: ExcelJS.Cell): number {
    const val = cell.value;
    if (val == null) return 0;
    if (typeof val === "object" && "result" in val) {
      return Number(val.result ?? 0);
    }
    return Number(val);
  }
  

  private downloadExtractedTemplate(): void {
    if (!this.parentData.fycode) return;
    this.extracting = true;
    this.serverMessage = null;
  debugger;
    this.uploadService.extractTemplate(this.selectedType, this.parentData.fycode, this.parentData.quartercode).subscribe({
      next: rows => {
        this.extracting = false;
        if (!rows.length) {
          this.serverSuccess = false;
          this.serverMessage = 'Nothing to extract yet — no Budget entries exist for this Financial Year.';
          return;
        }
  
        const workbook = new ExcelJS.Workbook();
        const worksheet = workbook.addWorksheet('Budget Data');
  
        // First header row
        worksheet.addRow([
          'Sr No','Budget Code','Indus Coverage Group','Pitched / Is Mandated',
          'Project Name','Mandated Company','Industry','Product','Issue Type',
          'Indicative Deal Size (Rs Cr)','Estimated Fee Pool (%)','Total Fees (Rs Cr)',
          'No. of BRLMs','JMF Keep Rate (%)','JMF Gross Fee (Rs Cr)',
          'Deal Probability (%)','JM Probability (%)','Expected Closure',
          '','', '' // placeholders for merged headers
        ]);
  
        // Second header row
        worksheet.addRow([
          '','','','','','','','','','','','','','','','','','',
          'Q1','Q2','Q3','Q4','Total',
          'Quarter','Amount',
          '' // Is Manual Calculation stays merged
        ]);
  
        // Merge headers
        for (let col = 1; col <= 18; col++) {
          const colLetter = worksheet.getColumn(col).letter;
          worksheet.mergeCells(`${colLetter}1:${colLetter}2`);
        }
        worksheet.mergeCells('S1:W1'); worksheet.getCell('S1').value = 'JMF PWR (Rs Cr)';
        worksheet.mergeCells('X1:Y1'); worksheet.getCell('X1').value = 'Left Lead';
        worksheet.mergeCells('Z1:Z2'); worksheet.getCell('Z1').value = 'Is Manual Calculation';
  
        // Style headers
        [1,2].forEach(rowNumber => {
          const row = worksheet.getRow(rowNumber);
          row.eachCell(cell => {
            cell.font = { bold: true };
            cell.alignment = { vertical: 'middle', horizontal: 'center', wrapText: true };
            cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD9E1F2' } };
            cell.border = { top:{style:'thin'}, left:{style:'thin'}, bottom:{style:'thin'}, right:{style:'thin'} };
          });
        });
  
        // Style merged header cells individually
        ['S1','X1','Z1'].forEach(addr => {
          const cell = worksheet.getCell(addr);
          cell.font = { bold: true };
          cell.alignment = { vertical: 'middle', horizontal: 'center', wrapText: true };
          cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFB6D7A8' } };
          cell.border = { top:{style:'thin'}, left:{style:'thin'}, bottom:{style:'thin'}, right:{style:'thin'} };
        });
  
        // Add dynamic rows from API

        rows.forEach((r: BulkUploadRow, idx: number) => {
          const dataRow = worksheet.addRow([
            idx+1, r.budgetCode, r.indusCoverageGroup, r.pitchedOrMandated,
            r.projectName, r.mandatedCompany, r.industry, r.product, r.issueType,
            r.indicativeDealSize, r.estimatedFeePool, r.totalFees, r.noOfBRLMs,
            r.jmfKeepRate, r.jmfGrossFee, r.dealProbability, r.jmProbability,
            r.expectedClosure,
            r.q1, r.q2, r.q3, r.q4, r.total,
            'Q' + this.parentData.quartercode, r.amount,
            r.isManualCalculation ?? '' // if you have this field
          ]);
  
          // Style each data row
          dataRow.eachCell(cell => {
            cell.border = { top:{style:'thin'}, left:{style:'thin'}, bottom:{style:'thin'}, right:{style:'thin'} };
            cell.alignment = { vertical:'middle', horizontal:'center' };
            // Optional zebra striping
            cell.fill = {
              type: 'pattern',
              pattern: 'solid',
              fgColor: { argb: dataRow.number % 2 === 0 ? 'FFFFFFFF' : 'FFF2F2F2' }
            };
          });

          

          // Allow editing only for Amount (col 24)
         // dataRow.getCell(24).protection = { locked: false };
        });
  
        // Auto-size columns
        worksheet.columns.forEach((column: any) => {
          if (!column) return; // skip undefined columns
          let maxLength = 0;
          column.eachCell({ includeEmpty: true }, (cell: any) => {
            const cellValue = cell.value ? cell.value.toString() : '';
            maxLength = Math.max(maxLength, cellValue.length);
          });
          column.width = maxLength + 2;
        });
        
  
        // Export
        workbook.xlsx.writeBuffer().then(buffer => {
          saveAs(new Blob([buffer]), `budget-${this.selectedType === 2 ? 'estimation' : 'actual'}-extract.xlsx`);
        });
      },
      error: err => {
        this.extracting = false;
        this.serverSuccess = false;
        this.serverMessage = err?.error?.message || 'Extract failed. Is the API running?';
      }
    });
  }
  

}
