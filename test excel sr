import { Component, Inject, EventEmitter, Input, Output  } from '@angular/core';
import { ExcelRow } from 'src/app/models/excel-row.model';
import { ExcelValidatorService } from 'src/app/services/shared/excel-validator.service';
import { apiService } from 'src/app/services/api/api.service';
import * as ExcelJS from 'exceljs';
import { saveAs } from 'file-saver';
import { BulkUploadRow,RowResult,UploadResponse  } from 'src/app/models/budget-data-model';


@Component({
  selector: 'app-budget-entry-upload',
  templateUrl: './budget-entry-upload.component.html',
  styleUrls: ['./budget-entry-upload.component.scss'],
	standalone: false
})
export class BudgetEntryUploadComponent {

  @Input() parentData: any;
  @Output() closed = new EventEmitter<boolean>();

  selectedType: number = 1;
  selectedFile: File | null = null;

  templateError: string | null = null;
  rows: ExcelRow[] = [];
  columns: string[] = [];

  isValidating = false;
  isSubmitting = false;
  submitMessage: string | null = null;
  submitSuccess = false;
  extracting = false;
  serverMessage: string | null = null;
  serverSuccess=false;

  constructor(
    private excelValidator: ExcelValidatorService,
    private uploadService: apiService
  ) {}

  get hasClientErrors(): boolean {
    return this.rows.some(r => r.hasError);
  }

  get errorRowCount(): number {
    return this.rows.filter(r => r.hasError).length;
  }

  onFileSelected(event: Event): void {
    const input = event.target as HTMLInputElement;
    this.selectedFile = input.files?.[0] ?? null;
    this.resetGrid();
  }

  async validateExcel(): Promise<void> {
    if (!this.selectedFile) return;

    this.isValidating = true;
    this.resetGrid();
debugger;
    try {
      const result = await this.excelValidator.parseAndValidate(this.selectedFile);

      if (!result.templateValid) {
        this.templateError = result.templateError;
        return;
      }
      debugger;
      this.rows = result.rows;
      this.columns = result.columns;
    } catch (err) {
      this.templateError = 'Could not read the file. Please make sure it is a valid .xlsx/.xls file.';
      console.error(err);
    } finally {
      this.isValidating = false;
    }
  }

  submit(): void {

    debugger;
    if (this.hasClientErrors || !this.rows.length || this.isSubmitting) return;

    this.isSubmitting = true;
    this.submitMessage = null;
    this.submitSuccess = false;

    const payload = {
      entrytype: this.selectedType,
      rows: this.rows.map(r => r.data),
      yearcode: this.parentData.fycode,       
      quartercode: this.parentData.quartercode, 
      rolename: this.parentData.rolename
    };

    this.uploadService.uploadData(payload as any).subscribe({
      next: (res: UploadResponse) => {
        this.isSubmitting = false;
    debugger;
        if (res.rows?.some(r => r.errors?.length)) {
          // merge server-side errors back into the same grid
          const errorMap = new Map(res.rows.map(r => [r.rowNumber, r.errors]));
          this.rows.forEach(r => {
            if (errorMap.has(r.rowNumber)) {
              r.errors = errorMap.get(r.rowNumber)!;
              r.hasError = true;
            } else {
              r.errors = [];
              r.hasError = false;
            }
          });
    
          const successCount = res.rows.filter(r => !r.errors?.length).length;
          const failedCount = res.rows.filter(r => r.errors?.length).length;
    
          //var msgcommon = `${successCount} row(s) saved successfully. ${failedCount} row(s) failed validation in the database — fix the highlighted rows in Excel and reupload.`;
          this.submitSuccess = false;
          this.submitMessage = res.resultMessage +' <br/> '+ `${successCount} row(s) saved successfully. ${failedCount} row(s) failed validation in the database — fix the highlighted rows in Excel and reupload.`;
            
        } else {
          this.submitSuccess = true;
          this.submitMessage = `All ${res.rows.length} row(s) saved successfully.`;
        }
      },
      error: (err) => {
        this.isSubmitting = false;
        this.submitSuccess = false;
        this.submitMessage = 'Upload failed: could not reach the API.';
        console.error(err);
      }
    });
    
  }

  private resetGrid(): void {
    this.templateError = null;
    this.rows = [];
    this.columns = [];
    this.submitMessage = null;
    this.submitSuccess = false;
  }

  close(): void {
    this.closed.emit(this.submitSuccess);
  }

  downloadTemplate(): void {
    debugger;
    if (this.selectedType === 1) {
      this.downloadBlankTemplate();
    } else {
      this.downloadExtractedTemplate();
    }
  }

