                  row.q3,

                  row.q4,

                  row.total,

                  'Q' + this.parentData.quartercode,

                  row.amount,

                  row.isManualCalculation ?? ''
                ]);


              // ============================================================
              // ROW STYLE
              // ============================================================

              dataRow.eachCell(

                cell => {

                  cell.border = {

                    top: {
                      style:
                        'thin'
                    },

                    left: {
                      style:
                        'thin'
                    },

                    bottom: {
                      style:
                        'thin'
                    },

                    right: {
                      style:
                        'thin'
                    }
                  };


                  cell.alignment = {

                    vertical:
                      'middle',

                    horizontal:
                      'center'
                  };


                  cell.fill = {

                    type:
                      'pattern',

                    pattern:
                      'solid',

                    fgColor: {

                      argb:

                        dataRow.number % 2 === 0

                          ? 'FFFFFFFF'

                          : 'FFF2F2F2'
                    }
                  };
                }
              );
            }
          );


          // ============================================================
          // AUTO WIDTH
          // ============================================================

          worksheet.columns.forEach(

            (column: any) => {

              if (!column) {
                return;
              }


              let maxLength = 0;


              column.eachCell(

                {
                  includeEmpty: true
                },

                (cell: ExcelJS.Cell) => {

                  const cellValue =
                    this.getCellDisplayValue(
                      cell
                    );


                  maxLength =

                    Math.max(

                      maxLength,

                      cellValue.length
                    );
                }
              );


              column.width =

                Math.min(

                  Math.max(

                    maxLength + 2,

                    12
                  ),

                  40
                );
            }
          );


          // ============================================================
          // EXPORT
          // ============================================================

          workbook.xlsx
            .writeBuffer()
            .then(

              buffer => {

                saveAs(

                  new Blob(
                    [buffer]
                  ),

                  `budget-${

                    this.selectedType === 2

                      ? 'estimation'

                      : 'actual'

                  }-extract.xlsx`
                );
              }
            );
        },


        // ============================================================
        // ERROR
        // ============================================================

        error: (
          error
        ) => {

          this.extracting = false;


          this.serverSuccess = false;


          this.serverMessage =

            error?.error?.message ||

            'Extract failed. Is the API running?';
        }
      });
